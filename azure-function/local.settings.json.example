{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "node",
    "ANTHROPIC_API_KEY": "← from console.anthropic.com",
    "CLAUDE_MODEL": "fast",
    "SP_SITE_URL": "← https://yourtenant.sharepoint.com/sites/recruitment",
