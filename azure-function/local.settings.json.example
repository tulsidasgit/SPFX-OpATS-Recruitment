    "SP_CLIENT_ID": "← Azure AD → App registrations → your app → Application (client) ID",
    "SP_CLIENT_SECRET": "← Azure AD → App registrations → your app → Certificates & secrets",
    "CORS_ORIGIN": "← https://your-app.azurestaticapps.net (or * for dev)"
  }
}
